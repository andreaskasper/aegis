# Copy to .env and fill in. Never commit .env.

# The public hostname you attached to the tunnel in the Zero Trust dashboard.
AEGIS_HOST=aegis.example.com

# Zero Trust -> Networks -> Tunnels -> your tunnel -> Install connector.
# The token is a credential for your account: treat it like a password.
TUNNEL_TOKEN=

AEGIS_LOG_LEVEL=info

# Secrets referenced as env: in config.yaml.
LEXWARE_TOKEN=
GITHUB_PAT=

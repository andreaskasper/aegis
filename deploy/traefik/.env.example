# Copy to .env and fill in. Never commit .env.

# The public hostname. Must match the certificate and the DNS record, and it
# is what AEGIS_PUBLIC_URL is built from.
AEGIS_HOST=aegis.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

AEGIS_LOG_LEVEL=info

# Secrets referenced as env: in config.yaml. Prefer file: references to
# Docker secrets for anything long-lived.
LEXWARE_TOKEN=
GITHUB_PAT=
